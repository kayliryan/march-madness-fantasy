# Copy to .env.local for local dev (npx supabase start prints URL/keys for local values).
# For production, set these in Vercel → Settings → Environment Variables instead.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — bypasses RLS. Used by supabaseAdmin and seed scripts. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stats provider ---
# When true, ESPNStatsProvider returns fixture data from src/mocks/fixtures/espn/.
# Currently true everywhere — the "real ESPN" code paths aren't implemented yet and fall
# back to the same fixtures regardless of this flag.
MOCK_ESPN=true

# --- AI features (draft advisor, standings narrator) ---
# Bills API credits directly (not covered by a Claude subscription plan).
ANTHROPIC_API_KEY=

# --- Email (league invites) ---
# If unset, invite emails are logged to the console instead of sent.
RESEND_API_KEY=

# --- Cron auth ---
# Required by GET /api/cron/sync-scores via `Authorization: Bearer {CRON_SECRET}`.
# Use a long random string in production.
CRON_SECRET=

# --- Demo league ---
# Same UUID in both — DEMO_LEAGUE_ID is used server-side by the seed script,
# NEXT_PUBLIC_DEMO_LEAGUE_ID is exposed to the client for /demo/league.
DEMO_LEAGUE_ID=
NEXT_PUBLIC_DEMO_LEAGUE_ID=

# --- App URL ---
# Used for Resend invite email links and the OAuth redirect target.
# Defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000
